{{ 'section-best-sellers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'best-sellers.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign blocks = section.blocks
  assign section_id = section.id
-%}

<section
  class="best-sellers section-{{ section_id }}"
  data-best-sellers
  data-wishlist-template="{{ 'sections.best_sellers.wishlist_added' | t: product_name: '[NAME]' }}"
>
  <div class="best-sellers__inner page-width">
    <div class="best-sellers__content">
      {%- comment -%} Navigation Tabs {%- endcomment -%}
      <div class="best-sellers__tabs--wrap scroll-trigger animate--slide-in">
        <header class="best-sellers__header">
          {%- if section.settings.section_label != blank -%}
            <p class="best-sellers__label">{{ section.settings.section_label | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="best-sellers__title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
        </header>

        <div class="best-sellers__tabs" role="tablist">
          {%- for block in blocks -%}
            {%- liquid
              assign coll = block.settings.collection
              if coll == blank
                continue
              endif
              assign tab_title = block.settings.collection_title | default: coll.title
            -%}
            <button
              type="button"
              class="best-sellers__tab {% if forloop.first %}is-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span>{{ tab_title | escape }}</span>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14.43 5.92999L20.5 12L14.43 18.07" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M3.5 12H20.33" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Product Cards Panels {%- endcomment -%}
      <div class="best-sellers__panels scroll-trigger animate--slide-in" role="tabpanel-container">
        {%- for block in blocks -%}
          {%- liquid
            assign coll = block.settings.collection
            if coll == blank
              continue
            endif
            assign product = block.settings.product | default: coll.products.first
          -%}
          <div
            class="best-sellers__panel {% if forloop.first %}is-active{% endif %}"
            data-panel="{{ forloop.index0 }}"
            role="tabpanel"
            {% unless forloop.first %}
              hidden
            {% endunless %}
          >
            {%- if product -%}
              <article class="best-sellers__card" data-product-title="{{ product.title | escape }}">
                <div class="best-sellers__media-container">
                  {%- comment -%} Badges {%- endcomment -%}
                  <div class="best-sellers__badges">
                    {%- for tag in product.tags limit: 3 -%}
                      {%- assign tag_dc = tag | downcase -%}
                      <span class="best-sellers__badge {% if tag_dc == 'sale' %}best-sellers__badge--sale{% endif %}">
                        {{ tag }}
                      </span>
                    {%- endfor -%}
                  </div>

                  {%- comment -%} Image {%- endcomment -%}
                  <a href="{{ product.url }}" class="best-sellers__image-link">
                    {%- if product.featured_media -%}
                      <picture>
                        <source
                          media="(max-width: 749px)"
                          srcset="{{ product.featured_media | image_url: width: 400 }} 1x, {{ product.featured_media | image_url: width: 800 }} 2x"
                        >
                        <source
                          media="(min-width: 750px)"
                          srcset="{{ product.featured_media | image_url: width: 816 }} 1x, {{ product.featured_media | image_url: width: 1632 }} 2x"
                        >
                        {{
                          product.featured_media
                          | image_url: width: 816
                          | image_tag:
                            loading: 'eager',
                            fetchpriority: 'high',
                            class: 'best-sellers__image',
                            alt: product.title
                        }}
                      </picture>
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </a>

                  {%- comment -%} Action Buttons {%- endcomment -%}
                  <div class="best-sellers__actions">
                    <button class="action-btn" data-action="wishlist" aria-label="Add to Wishlist">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20.84 4.60999C20.3292 4.099 19.7228 3.69364 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69364 13.5708 4.099 13.06 4.60999L12 5.66999L10.94 4.60999C9.90831 3.5783 8.50903 2.9987 7.05 2.9987C5.59096 2.9987 4.19169 3.5783 3.16 4.60999C2.1283 5.64169 1.54871 7.04096 1.54871 8.49999C1.54871 9.95903 2.1283 11.3583 3.16 12.39L4.22 13.45L12 21.23L19.78 13.45L20.84 12.39C21.351 11.8792 21.7564 11.2728 22.0329 10.6053C22.3095 9.93789 22.4518 9.22248 22.4518 8.49999C22.4518 7.77751 22.3095 7.0621 22.0329 6.39464C21.7564 5.72718 21.351 5.12075 20.84 4.60999V4.60999Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>

                    {%- assign current_variant = product.selected_or_first_available_variant -%}
                    <button
                      class="action-btn"
                      data-action="add-to-cart"
                      data-variant-id="{{ current_variant.id }}"
                      {% unless product.available %}
                        disabled
                      {% endunless %}
                      aria-label="Add to Cart"
                    >
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15.58 12C15.58 13.98 13.98 15.58 12 15.58C10.02 15.58 8.42001 13.98 8.42001 12C8.42001 10.02 10.02 8.42004 12 8.42004C13.98 8.42004 15.58 10.02 15.58 12Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M12 20.27C15.53 20.27 18.82 18.19 21.11 14.59C22.01 13.18 22.01 10.81 21.11 9.39997C18.82 5.79997 15.53 3.71997 12 3.71997C8.47 3.71997 5.18 5.79997 2.89 9.39997C1.99 10.81 1.99 13.18 2.89 14.59C5.18 18.19 8.47 20.27 12 20.27Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="best-sellers__info">
                  <h3 class="best-sellers__product-name">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                  <div class="best-sellers__price-box">
                    <span class="price--current">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="price--compare">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Wishlist Modal & Overlay {%- endcomment -%}
  <div class="best-sellers__modal-wrapper" data-modal-wrapper>
    <div class="best-sellers__overlay" data-close-modal></div>
    <div class="best-sellers__modal" role="dialog" aria-modal="true">
      <button class="modal-close" data-close-modal aria-label="Close">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
      <div class="modal-content" data-modal-text></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.best-sellers.name",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "t:sections.best-sellers.settings.section_label.label",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.best-sellers.settings.title.label",
      "default": "Trending Products"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.best-sellers.blocks.collection.name",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.best-sellers.blocks.collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "t:sections.best-sellers.blocks.collection.settings.collection_title.label",
          "info": "Replaces the default collection title"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.best-sellers.blocks.collection.settings.product.label",
          "info": "Replaces the first product in the collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
